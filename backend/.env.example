# Port on which Express API server runs
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# PostgreSQL Database Host
DB_HOST=localhost

# PostgreSQL Database Port
DB_PORT=5432

# PostgreSQL Database User
DB_USERNAME=postgres

# PostgreSQL Database Password (never commit real passwords)
DB_PASSWORD=your_postgres_password_here

# PostgreSQL Database Name
DB_NAME=slotify

# JWT Secret Key for authenticating Shop Owners and Admin
JWT_SECRET=your_jwt_secret_key_here

# Allowed CORS Origins for frontend and web clients (* for dev)
CORS_ORIGIN=*
